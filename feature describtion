        add(ModBlocks.LASER_BASE.get(), "Turret Baseplate");

        // 3. Items
        add(ModItems.BACKFLIP_TOOL.get(), "Backflip Tool");

        // 4. UI / Screens
        add(ModI18n.Screen.REACTOR_TITLE, "Reactor Core Diagnostics");
